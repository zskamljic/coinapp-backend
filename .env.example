# Admin SDK credentials for this backend. Generate in the Firebase console:
#   Project settings -> Service accounts -> Generate new private key
# Never commit the key file. Point GOOGLE_APPLICATION_CREDENTIALS at it instead.
GOOGLE_APPLICATION_CREDENTIALS=/etc/coinapp/service-account.json

# Or inline the same JSON as one value (handy for systemd EnvironmentFile):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

FIREBASE_DATABASE_URL=https://coinapp-a454b.firebaseio.com

# Web API key, used only to verify Google ID tokens from the browser.
# This is the same public key the web app ships in its bundle.
FIREBASE_API_KEY=AIzaSyApHl_Lw7AH80b-hKmHHo41bVpSrC85yUg

# How often to re-scrape the ECB, in hours. 12 is plenty.
SYNC_INTERVAL_HOURS=12

# HTTP
LISTEN_ADDR=:8080

# CORS origins allowed to call the share API, as a JSON array.
ALLOW_ORIGINS=["https://your-app.web.app"]

# Where "share this collection" links point.
SHARE_LINK_ORIGIN=https://your-app.web.app
